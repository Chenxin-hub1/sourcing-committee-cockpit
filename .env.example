# Sourcing Committee Cockpit —— 环境配置模板
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略；真实口令只写在 .env，不要提交。

# 对外访问地址（提醒消息里「Open Action Case」链接的前缀，部署时改成服务器实际地址，如 http://sourcing-cockpit.zf-lifetec.com/）
SC_PUBLIC_URL=http://localhost:8062/

# 免安装方式（start.bat）监听的端口；Docker 方式不看这项（改 docker-compose.yml）。域名就绪后改成 80，地址就不带端口号
SC_PORT=8031

# 个人账号（v3 Phase-6，取代原来的共享管理员口令 SC_ADMIN_PASSWORD）
# 允许自注册的公司邮箱域名（逗号分隔）
SC_ALLOWED_EMAIL_DOMAINS=zf.com,zf-lifetec.com
# 首个 Sourcing 管理员：启动时若还没有任何可用的管理员，就用这两项建一个（已有管理员时忽略）。
# 登录后在 Accounts 页把真人提升为管理员，再停用这个账号；管理员全丢了时填上它重启即可恢复
SC_BOOTSTRAP_ADMIN_EMAIL=
SC_BOOTSTRAP_ADMIN_PASSWORD=

# 参考时区（IANA 名）：登记截止、"今天/到期"判断、上传文件名里的日期都按它算。委员会按欧洲时间开会，用 Europe/Berlin
SC_TIMEZONE=Europe/Berlin

# 首次启动且库为空时，是否装载与模板一致的演示数据（正式使用建议 false）
SC_SEED_ON_EMPTY=true

# 宿主机 data 目录所属用户/组；非 1000 时填入 id -u / id -g 的输出
SC_UID=1000
SC_GID=1000

# ---- 提醒邮件：公司 SMTP 中继（host 留空 = 该通道仅记日志） ----
SC_SMTP_HOST=
SC_SMTP_PORT=25
SC_SMTP_STARTTLS=false
SC_SMTP_USER=
SC_SMTP_PASSWORD=
SC_SMTP_FROM=sourcing-cockpit@zf.com

# ---- 提醒 Teams ----
# 优先走 Graph 直发频道消息（与邮件共用 Graph 凭据）：下面两个 ID 配齐即启用。
# ID 从 Teams 网页版频道链接取：链接里 groupId= 团队 ID，19: 开头的一段是频道 ID。
# 注意：微软将应用权限直发定位为迁移场景（可能计费），见 DEPLOY.md 限制注记；
# 不想直发就清空这两个 ID，回落 webhook 方式。
SC_TEAMS_TEAM_ID=
SC_TEAMS_CHANNEL_ID=
# webhook 兜底（Graph ID 未配时使用；url 留空 = Teams 通道仅记日志）
# format: teams = 发到频道 Incoming Webhook；flow = Power Automate 按收件人私发
SC_TEAMS_WEBHOOK_URL=
SC_TEAMS_WEBHOOK_FORMAT=teams

# ---- Graph 接入（SharePoint 建单 + 邮件兜底 + Teams webhook 认证，共用一套凭据） ----
# 需 IT 提供：Entra 应用注册（client secret），权限按需勾选并管理员同意：
#   Sites.Selected（建单与演示文件，另需对站点授 write 角色）+ Mail.Send（邮件）
SC_GRAPH_TENANT_ID=
SC_GRAPH_CLIENT_ID=
SC_GRAPH_CLIENT_SECRET=
# SharePoint：建单要凭据 + 下面两项配齐；演示文件上传只要凭据 + 站点地址（同一个站点级 write 授权即可）
# 站点地址，如 https://xxx.sharepoint.com/sites/SourcingCommittee
SC_SP_SITE_URL=
# 目标 List 显示名（建议建列时用无空格名称）
SC_SP_LIST_NAME=
# 演示文件存放：文档库显示名（留空 = 站点默认库 Documents）与库内文件夹（每个案例号再建一层子文件夹）
SC_SP_LIBRARY_NAME=
SC_SP_FOLDER=Sourcing Cockpit
# 邮件兜底发件邮箱（SMTP 未配置时生效；需 IT 用应用访问策略允许应用以此邮箱发信）
# 发件邮箱，如 sourcing-cockpit@zf.com；与 SMTP 都留空 = 邮件记 skipped
SC_GRAPH_SENDER=
